# ==============================================================================
# Admin Backend Environment Variables Template
# Copy this file to .env and configure values before starting the service.
#
# CRITICAL SECURITY NOTE:
# JWT_SECRET and JWT_REFRESH_SECRET MUST be set to cryptographically strong
# secrets of at least 16 characters. Fallbacks and common placeholder strings
# are explicitly forbidden and will cause the application to fail fast at startup.
# ==============================================================================

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database connection string
MONGO_URI=mongodb://localhost:27017/conza_admin

# JSON Web Token Configuration (REQUIRED - min 16 characters)
JWT_SECRET=your_long_cryptographically_secure_admin_jwt_secret_min_16_chars
JWT_EXPIRES_IN=7d

# Refresh Token Configuration (min 16 characters if specified)
JWT_REFRESH_SECRET=your_long_cryptographically_secure_admin_refresh_secret_min_16_chars
JWT_REFRESH_EXPIRES_IN=30d

# Mailer configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@conza.in
FROM_NAME="Conza Admin"

# Cross-database connections
CUSTOMERS_MONGO_URI=mongodb://localhost:27017/conza_customers
WORKERS_MONGO_URI=mongodb://localhost:27017/conza_bp
SELLERS_MONGO_URI=mongodb://localhost:27017/conza_vendor

# Redis caches
CUSTOMERS_REDIS_URL=redis://localhost:6379
WORKERS_REDIS_URL=redis://localhost:6379

# Cloudinary Integration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
