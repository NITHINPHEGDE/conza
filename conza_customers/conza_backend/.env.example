# ==============================================================================
# Customer Backend Environment Variables Template
# Copy this file to .env and configure values before starting the service.
#
# CRITICAL SECURITY NOTE:
# JWT_SECRET MUST be set to a cryptographically strong secret of at least 16
# characters. Fallbacks and common placeholder strings are explicitly forbidden
# and will cause the application to fail fast at startup.
# ==============================================================================

PORT=5000
NODE_ENV=development

# Database connection string
MONGO_URI=mongodb://localhost:27017/conza_customers

# JSON Web Token Configuration (REQUIRED - min 16 characters)
JWT_SECRET=your_long_cryptographically_secure_customer_jwt_secret_min_16_chars
JWT_EXPIRE=30d

# Optional cross-service BP secret for socket cross-authorization
# BP_JWT_SECRET=your_bp_jwt_secret_min_16_chars

# Redis (optional, enables socket adapter and distributed caching)
REDIS_URL=redis://localhost:6379
REDIS_LOCK_TTL=5000
CACHE_BYPASS=false

# Map / Cloudinary Integrations
MAPPLS_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Internal communications secret
INTERNAL_SOCKET_SECRET=your_internal_socket_secret_min_16_chars

# Admin database URI (optional, for cross-database admin sync)
ADMIN_MONGO_URI=
