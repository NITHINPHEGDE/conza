# Socket Security Test — .env file
# Copy this file to .env.test and fill in real values.
# These credentials must exist in your local MongoDB instance.

# ── Customer Backend (port 5000 by default) ───────────────────────────────────
CUSTOMER_BACKEND_URL=http://localhost:5000

# JWT signed with the SAME secret as conza_customers/conza_backend
CUSTOMER_JWT_SECRET=your_customer_jwt_secret_here_min16chars

# MongoDB ObjectId of Customer A (the authenticated user for these tests)
CUSTOMER_A_ID=000000000000000000000001
# MongoDB ObjectId of Customer B (the victim user — must exist in DB)
CUSTOMER_B_ID=000000000000000000000002

# ── BP Backend (port 5005 by default) ─────────────────────────────────────────
BP_BACKEND_URL=http://localhost:5005

# JWT signed with the SAME secret as conza_bp/bp_backend
BP_JWT_SECRET=your_bp_jwt_secret_here_min16chars

# MongoDB ObjectId of Worker A (authenticated worker)
WORKER_A_ID=000000000000000000000003
# MongoDB ObjectId of Worker B (the victim worker — must exist in DB)
WORKER_B_ID=000000000000000000000004

# ── Vendor Backend (port 5001 by default) ─────────────────────────────────────
VENDOR_BACKEND_URL=http://localhost:5001

# JWT signed with the SAME secret as conza_vendor/sellerb
VENDOR_JWT_SECRET=your_vendor_jwt_secret_here_min16chars

# MongoDB ObjectId of Seller A (authenticated seller)
SELLER_A_ID=000000000000000000000005
# MongoDB ObjectId of Seller B (the victim seller — must exist in DB)
SELLER_B_ID=000000000000000000000006

# ── Booking IDs ───────────────────────────────────────────────────────────────
# A booking owned by Customer B (Customer A must NOT be the owner or a worker)
BOOKING_B_CUSTOMER_ID=000000000000000000000007

# A booking assigned to Worker B (Worker A must NOT be assigned)
BOOKING_B_WORKER_ID=000000000000000000000008

# A booking owned by Customer A (for the ALLOWED test)
BOOKING_A_CUSTOMER_ID=000000000000000000000009

# A booking assigned to Worker A (for the ALLOWED test)
BOOKING_A_WORKER_ID=000000000000000000000010
