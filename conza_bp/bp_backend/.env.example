# ==============================================================================
# BP / Worker Backend Environment Variables Template
# Copy this file to .env and configure values before starting the service.
#
# CRITICAL SECURITY NOTE:
# JWT_SECRET MUST be set to a cryptographically strong secret of at least 16
# characters. Fallbacks and common placeholder strings are explicitly forbidden
# and will cause the application to fail fast at startup.
# ==============================================================================

PORT=5005
NODE_ENV=development

# Database connection string
MONGO_URI=mongodb://localhost:27017/conza_bp

# JSON Web Token Configuration (REQUIRED - min 16 characters)
JWT_SECRET=your_long_cryptographically_secure_bp_jwt_secret_min_16_chars
JWT_EXPIRES_IN=30d

# Optional cross-service Customer secret for customer socket connections
# CUSTOMER_JWT_SECRET=your_customer_jwt_secret_min_16_chars

# Cloudinary Integration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Worker Tracking and Flush Config
LOCATION_TIMEOUT_MS=30000
LOCATION_BUFFER_FLUSH_MS=15000

# Redis (optional, enables socket adapter and location caching)
REDIS_URL=redis://localhost:6379
